# ElevenLabs Konfiguration für Enrika & Emin - Level 30
# Kopiere diese Datei zu .env und trage deinen Key und deine Stimmen ein:
# cp .env.example .env

ELEVENLABS_API_KEY=dein_elevenlabs_api_key_hier

# Stimm-IDs (Tipp: Führe 'python3 generate_voices.py --list-voices --api-key DEIN_KEY' aus)
# Lord Dreißig: z.B. pNInz6obpgDQGcFmaJgB (Adam) oder onwK4e9ZLuTAKqWW03F9 (Daniel)
BOSS_VOICE_ID=

# Showmaster Pablo: z.B. ErXwobaYiN019PkySvjV (Antoni) oder TX3LPaxmHKxFdv7VOQHJ (Liam)
NARRATOR_VOICE_ID=
